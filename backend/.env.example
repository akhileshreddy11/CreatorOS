GEMINI_API_KEY=replace-with-your-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_DELAY=2
CREATOROS_DATABASE_URL=sqlite:///./creatoros.db
CREATOROS_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Free local photorealistic talking presenter
CREATOROS_AVATAR_PROVIDER=sadtalker
CREATOROS_AVATAR_IMAGE=assets/creatoros_presenter.jpg
CREATOROS_SADTALKER_DIR=tools/SadTalker
CREATOROS_SADTALKER_EXPRESSION_SCALE=1.0
